---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);

const STACK = [
  {
    category: "Backend",
    items: ["Python", "Java", "FastAPI", "Spring", "Node.js"],
  },
  {
    category: "AI / Data",
    items: ["LLM", "RAG", "Vector DB", "Elasticsearch", "Jena Fuseki"],
  },
  {
    category: "Frontend",
    items: ["TypeScript", "JavaScript", "Sigma.js", "Graphology", "Webpack"],
  },
  {
    category: "Infra",
    items: ["Docker", "Jenkins", "Git", "Linux"],
  },
];

const FOCUS = [
  "RAG Pipeline",
  "Vector DB",
  "Text-to-SQL",
  "Data Pipeline",
  "LLM",
  "Enterprise AI",
];
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-12 pb-14", "border-b border-border"]}>
      <p class="text-xs font-medium tracking-[0.2em] uppercase text-accent mb-6">
        Fullstack · AI/Data Engineer
      </p>

      <h1 class="text-5xl font-bold sm:text-6xl leading-tight tracking-tight">
        Youngsang Park
      </h1>
      <p class="mt-2 text-2xl font-light text-foreground/70">박영상</p>

      <div class="mt-8 max-w-2xl">
        <p class="text-base leading-relaxed">
          11년의 풀스택 개발 경험을 바탕으로 <strong>LLM 기반 RAG 파이프라인</strong>과
          <strong>데이터 파이프라인</strong>을 설계·개발·운영합니다.
          백엔드부터 AI 파이프라인, Vector DB, 프론트엔드까지 End-to-end로
          엔터프라이즈 AI 프로덕트를 만들고 있습니다.
        </p>
      </div>

      <div class="mt-8 space-y-1 text-sm text-foreground/70">
        <p>BIMATRIX · 기술연구소 AI 융합팀</p>
        <p>Based in Seoul, Republic of Korea</p>
      </div>

      <!-- Focus Areas -->
      <div class="mt-10">
        <p class="text-xs font-medium tracking-[0.2em] uppercase text-foreground/50 mb-3">
          Focus Areas
        </p>
        <p class="text-sm text-foreground/80 mb-4 leading-relaxed">
          RAG · Vector DB · 데이터 파이프라인을 활용한
          <strong>End-to-end AI 서비스 설계</strong>에 집중하고 있습니다.
        </p>
        <div class="flex flex-wrap gap-x-4 gap-y-2">
          {FOCUS.map(item => (
            <span class="text-base font-medium">{item}</span>
          ))}
        </div>
      </div>

      <!-- Tech Stack Grid -->
      <div class="mt-12">
        <p class="text-xs font-medium tracking-[0.2em] uppercase text-foreground/50 mb-5">
          Tech Stack
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-6">
          {STACK.map(group => (
            <div>
              <h3 class="text-sm font-semibold text-accent border-b border-accent/30 pb-2 mb-3">
                {group.category}
              </h3>
              <ul class="space-y-1.5">
                {group.items.map(item => (
                  <li class="text-sm text-foreground/85">{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      {
        SOCIALS.length > 0 && (
          <div class="mt-12 flex items-center">
            <span class="sr-only">Social Links:</span>
            <Socials />
          </div>
        )
      }
    </section>

    {
      sortedPosts.length > 0 && (
        <section id="projects" class="pt-14 pb-6">
          <h2 class="text-2xl font-semibold tracking-tight">Projects</h2>
          <ul class="mt-6">
            {sortedPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-10 text-center">
      <LinkButton href="/posts/">
        All Projects
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>